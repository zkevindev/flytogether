# Keep real deployment settings OUTSIDE this repository.
# Example location: ~/.config/flytogether/deploy.env
DEPLOY_HOST=
DEPLOY_USER=root
DEPLOY_SSH_PORT=22

# Set either a local SSH key path, a local password file, or use your SSH agent.
DEPLOY_KEY_FILE=
DEPLOY_PASSWORD_FILE=

# Linux deployment directory and local backend port.
DEPLOY_PATH=/opt/flytogether
DEPLOY_APP_PORT=8080

# A DNS hostname pointing to DEPLOY_HOST. Leave blank for HTTP-only IP access.
# HTTPS is required for microphone access from another device.
DEPLOY_DOMAIN=
