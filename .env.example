# Copy to .env locally, or configure /etc/flytogether.env on the server.
LISTEN_ADDR=127.0.0.1:8080
WEB_DIR=web/dist
PUBLIC_URL=
# Keep this outside release directories in production.
SAVE_PATH=data/games.db
SAVE_RETENTION_HOURS=168

# Optional Linx Realtime API configuration. Keep the API key out of Git.
LINGXI_REALTIME_URL=wss://xrobo-io.qiniuapi.com/v1/realtime
LINGXI_REALTIME_MODEL=lingxi-realtime
LINGXI_REALTIME_API_KEY=

# Global voice resource caps; daily counts use UTC and persist in SQLite.
# Realtime connections and output-only TTS have separate limits; TTS concurrency is 1.
LINGXI_MAX_CONNECTIONS=4
LINGXI_SESSION_SECONDS=900
LINGXI_REALTIME_DAILY_LIMIT=2000
LINGXI_TTS_DAILY_LIMIT=1000

# Private read-only operations UI at /admin. Empty key disables UI access and new diagnostics.
# Generate at least 32 random characters; never commit the real value.
ADMIN_ACCESS_KEY=
DIAGNOSTICS_RETENTION_HOURS=168
# Text only, no audio recordings. Set false to retain metadata without dialogue text.
DIAGNOSTICS_TRANSCRIPTS=true
