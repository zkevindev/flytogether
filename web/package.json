{
  "name": "flytogether-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test:board": "node --experimental-strip-types --test scripts/board-layout.test.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:voice": "node --test scripts/voice-lifecycle.test.mjs",
    "test:presentation": "node --experimental-strip-types --test scripts/presentation.test.mjs",
    "test:scene": "node --experimental-strip-types --test scripts/scene.test.mjs",
    "test:scene:browser": "node scripts/scene-browser.mjs",
    "test:auto-voice:browser": "node scripts/auto-voice-browser.mjs",
    "test:voice:realtime": "node scripts/realtime-browser.mjs",
    "test:pages:browser": "node scripts/pages-browser.mjs",
    "test:fun:browser": "node scripts/fun-browser.mjs",
    "test:narration": "node --experimental-strip-types --test scripts/narration.test.mjs scripts/sfx.test.mjs",
    "test:voice-buffer:browser": "node scripts/voice-buffer-browser.mjs",
    "capture:docs": "node scripts/capture-docs.mjs",
    "test:onboarding:browser": "node scripts/onboarding-browser.mjs",
    "test:flows:browser": "node scripts/flow-regressions-browser.mjs",
    "test:network:voice": "node scripts/network-voice-browser.mjs",
    "test:network:bot": "node scripts/network-bot-browser.mjs",
    "test:network:browser": "node scripts/network-browser.mjs",
    "test:coach:browser": "node scripts/coach-browser.mjs",
    "test:saves:browser": "node scripts/saves-browser.mjs",
    "test:audio:browser": "node scripts/audio-settings-browser.mjs",
    "test:saves:deployed": "node scripts/saves-deployed-browser.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
